{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"],
    "noImplicitAny": false,
    "paths": {
      "@hodlfinance/hermes-homechat-shared/core": ["./src/index.ts"]
    }
  },
  "include": ["native/*.ts", "native/src/**/*.ts", "native/src/**/*.tsx", "native/core/**/*.ts", "native/ui/**/*.ts", "scripts/native-typecheck/host-modules.d.ts"]
}
